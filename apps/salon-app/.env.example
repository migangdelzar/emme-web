# ─── Local Dev ───
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:3000
API_PROXY_TARGET=http://localhost:8081
VITE_OIDC_ISSUER=http://localhost:8180/realms/emme
VITE_OIDC_CLIENT_ID=emme-salon-app
VITE_WEB_BASE_DOMAIN=localhost
VITE_SENTRY_DSN=

# ─── Subdomain simulation (production-like) ───
# lvh.me resolves all subdomains to 127.0.0.1
# Open: http://studio-a.lvh.me:3000 → auto-selects tenant "studio-a"
# Open: http://nails-by-maria.lvh.me:3000 → auto-selects tenant "nails-by-maria"
# Open: http://localhost:3000 → shows tenant selector UI

# ─── Firebase (Google Calendar/Sheets) ───
